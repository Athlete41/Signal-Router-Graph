@startuml
title [ER 图 - B2] 展开 B1:"开发板" — 领域实体与关系

' B2 实体视图: 展开 B1"开发板"核心实体，展示字段级定义
'
' B1 核心实体: 开发板 → LED, 按键, USB接口, PC主机
' B2 展开: 每个实体拆解为组件级定义

entity "BSP主模块\n(BSP Initializer)" as bsp {
  * 硬件初始化状态 : enum
  --
  电源管理
  时钟树配置
}

entity "LED测试模块\n(LEDTest)" as ledtest {
  * 延时函数指针 : void(*)(uint32_t)
  * LED设置函数指针 : void(*)(uint8_t)
  --
  任务参数 : ledBlinkParams_t <<optional>>
  当前引脚状态 : GPIO_PinState
}

entity "EXTI分发器\n(EXTI Dispatcher)" as exti {
  * 钩子表 : [16线][5钩子/线]
  --
  + 注册回调(线号, 回调函数, 上下文)
  + 注销回调(线号, 回调函数)
  + 分发(线号, GPIO_Pin)
}

entity "USB设备栈\n(CDC)" as usb {
  * 接收缓冲区 : 2048字节
  * 发送缓冲区 : 2048字节
  --
  + 初始化USB设备()
  + CDC_Transmit_FS(data, len)
  + CDC_Receive_FS(data, len)
}

entity "CubeMX初始化" as cubemx {
  * 时钟配置 : HSE→PLL→144MHz
  * GPIO配置 : PC13, PA15, PA11, PA12
  --
  + STM32_CubeMX_Init()
}

entity "HAL库" as hal {
  * SysTick定时器 : 1ms精度
  --
  GPIO控制 : 写引脚, 读引脚
  中断处理 : 回调入口
  USB外设驱动 : PCD层
}

entity "主应用\n(Main)" as mainapp {
  * 循环周期 : 500ms
  * USB CDC : 启用/禁用 <<USE_USB_CDC>>
  --
  运行LED闪烁循环
}

' ── 关系 ──
mainapp ||..|| ledtest : "驱动"
mainapp ||..|| usb : "使用(可选)"
ledtest ||..|| bsp : "通过函数指针调用"
mainapp ||..|{ exti : "可能触发"
exti ||..|| usb : "DFU钩子触发断开"
usb ||..|| hal : "基于HAL USB驱动"
cubemx ||..|| hal : "配置并初始化"
cubemx ||..|| usb : "初始化建立"
hal ||..|{ exti : "回调入口"
bsp ||..|| cubemx : "调用初始化"

note top of mainapp
  【B2】展开 B1"开发板"核心实体，
  展示组件级属性和关系基数。
  B1 仅见: 开发板→LED/USB/按键/PC
end note
@enduml
